# ─────────────────────────────────────────────────────────────
# Expense Tracker – environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Comma separated list of extra allowed origins (optional)
CORS_ORIGINS=

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker?schema=public

# JWT secrets – generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Admin bootstrap account (used by `npm run db:seed`)
ADMIN_EMAIL=admin@expense-tracker.app
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator

# ── Email (verification / password reset / reminders) ─────────
# Leave SMTP_HOST empty to run in "console mail" mode: messages are
# written to the server log and (in development) the action link is
# returned in the API response so the flow stays testable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Expense Tracker <no-reply@expense-tracker.app>"

# ── Google login (optional) ───────────────────────────────────
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# Authorised JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=

# ── AI assistant (optional) ───────────────────────────────────
# Any OpenAI-compatible chat completions endpoint works.
# Without a key the assistant falls back to a deterministic
# rule-based engine that analyses the user's real data.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ── Behaviour ─────────────────────────────────────────────────
# Minutes between recurring-transaction / reminder scheduler runs
SCHEDULER_INTERVAL_MINUTES=15
